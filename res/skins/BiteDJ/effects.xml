<Template>
  <WidgetGroup>
    <ObjectName>BeatFX_Container</ObjectName>
    <Layout>vertical</Layout>
    <Size>180f,0me</Size>
    <Children>

      <WidgetGroup>
        <ObjectName>FxPanel_TabBar</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,36f</Size>
        <Children>
          
          <PushButton>
            <ObjectName>FxPanel_TabFx</ObjectName>
            <Size>0me,36f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>FX</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>FX</Text>
            </State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[FxPanel],fx</ConfigKey>
              <EmitOnDownPress>true</EmitOnDownPress>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>FxPanel_TabKey</ObjectName>
            <Size>0me,36f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>Key</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>Key</Text>
            </State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[FxPanel],key</ConfigKey>
              <EmitOnDownPress>true</EmitOnDownPress>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      
      <WidgetStack currentpage="[FxPanel],current">
        <ObjectName>FxPanel_Stack</ObjectName>
        <SizePolicy>me,i</SizePolicy>
        <Children>

          <WidgetGroup trigger="[FxPanel],fx">
            <ObjectName>FxPanel_Page</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>

              <WidgetGroup>
                <ObjectName>BeatFX_Header</ObjectName>
                <Layout>vertical</Layout>
                <Size>0me,140f</Size>
                <Children>

                  <EffectChainPresetSelector>
                    <ObjectName>EffectSelector</ObjectName>
                    <EffectUnitGroup>[EffectRack1_EffectUnit1]</EffectUnitGroup>
                    <Size>0me,32f</Size>
                  </EffectChainPresetSelector>

                  <WidgetGroup>
                    <ObjectName>BeatFX_DeckRouting</ObjectName>
                    <Layout>horizontal</Layout>
                    <Size>0me,44f</Size>
                    <Children>
                      <PushButton>
                        <ObjectName>BeatFX_DeckAssign1</ObjectName>
                        <Size>0me,44f</Size>
                        <NumberStates>2</NumberStates>
                        <State>
                          <Number>0</Number>
                          <Text>1</Text>
                        </State>
                        <State>
                          <Number>1</Number>
                          <Text>1</Text>
                        </State>
                        <Connection>
                          <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel1]_enable</ConfigKey>
                          <ConnectValueToWidget>true</ConnectValueToWidget>
                        </Connection>
                      </PushButton>
                      <PushButton>
                        <ObjectName>BeatFX_DeckAssign2</ObjectName>
                        <Size>0me,44f</Size>
                        <NumberStates>2</NumberStates>
                        <State>
                          <Number>0</Number>
                          <Text>2</Text>
                        </State>
                        <State>
                          <Number>1</Number>
                          <Text>2</Text>
                        </State>
                        <Connection>
                          <ConfigKey>[EffectRack1_EffectUnit1],group_[Channel2]_enable</ConfigKey>
                          <ConnectValueToWidget>true</ConnectValueToWidget>
                        </Connection>
                      </PushButton>
                    </Children>
                  </WidgetGroup>

                  <WidgetGroup>
                    <ObjectName>BeatFX_WetRow</ObjectName>
                    <Layout>horizontal</Layout>
                    <Size>0me,16f</Size>
                    <Children>
                      <Label>
                        <ObjectName>BeatFX_MixLabel</ObjectName>
                        <Text>Mix</Text>
                        <Size>28f,me</Size>
                      </Label>
                      <VuMeter>
                        <ObjectName>BeatFX_MixMeter</ObjectName>
                        <Size>0me,10f</Size>
                        <PathBack scalemode="STRETCH">icons/effect_meter_bg.png</PathBack>
                        <PathVu scalemode="STRETCH">icons/effect_meter_fg.png</PathVu>
                        <Horizontal>true</Horizontal>
                        <PeakHoldSize>0</PeakHoldSize>
                        <PeakHoldTime>0</PeakHoldTime>
                        <PeakFallTime>0</PeakFallTime>
                        <PeakFallStep>0</PeakFallStep>
                        <Connection>
                          <ConfigKey>[EffectRack1_EffectUnit1],mix</ConfigKey>
                        </Connection>
                      </VuMeter>
                    </Children>
                  </WidgetGroup>

                  <PushButton>
                    <ObjectName>BeatFX_ActiveToggle</ObjectName>
                    <Size>0me,28f</Size>
                    <NumberStates>2</NumberStates>
                    <State>
                      <Number>0</Number>
                      <Text>Off</Text>
                    </State>
                    <State>
                      <Number>1</Number>
                      <Text>Active</Text>
                    </State>
                    <Connection>
                      <ConfigKey>[EffectRack1_EffectUnit1_Effect1],enabled</ConfigKey>
                      <ConnectValueToWidget>true</ConnectValueToWidget>
                    </Connection>
                  </PushButton>

                </Children>
              </WidgetGroup>

              
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">1</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">2</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">3</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">4</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">5</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">6</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">7</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">8</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">9</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">10</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">11</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">12</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">13</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">14</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">15</SetVariable>
              </Template>
              <Template src="skin:templates/effect_param_row.xml">
                <SetVariable name="rack">1</SetVariable>
                <SetVariable name="unit">1</SetVariable>
                <SetVariable name="effect">1</SetVariable>
                <SetVariable name="param">16</SetVariable>
              </Template>

              <WidgetGroup><ObjectName>BeatFX_BottomKnobs</ObjectName><Layout>horizontal</Layout><Size>0me,min</Size><Children><WidgetGroup><Layout>vertical</Layout><Size>me,min</Size><Children><Label><Text>MIX</Text><Size>0me,16f</Size><Alignment>center</Alignment></Label><KnobComposed><Size>0me,56f</Size><Knob scalemode="STRETCH_ASPECT">icons/knob.svg</Knob><MinAngle>-140</MinAngle><MaxAngle>140</MaxAngle><Connection><ConfigKey>[EffectRack1_EffectUnit1],mix</ConfigKey></Connection></KnobComposed></Children></WidgetGroup><WidgetGroup><Layout>vertical</Layout><Size>me,min</Size><Children><Label><Text>SUPER</Text><Size>0me,16f</Size><Alignment>center</Alignment></Label><KnobComposed><Size>0me,56f</Size><Knob scalemode="STRETCH_ASPECT">icons/knob.svg</Knob><MinAngle>-140</MinAngle><MaxAngle>140</MaxAngle><Connection><ConfigKey>[EffectRack1_EffectUnit1],super1</ConfigKey></Connection></KnobComposed></Children></WidgetGroup></Children></WidgetGroup><WidgetGroup>
                <ObjectName>BeatFX_Spacer</ObjectName>
                <Size>0me,0me</Size>
              </WidgetGroup>

            </Children>
          </WidgetGroup>

          
          <WidgetGroup trigger="[FxPanel],key">
            <ObjectName>FxPanel_Page</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>

              <Template src="skin:templates/keyfx_deck_row.xml">
                <SetVariable name="channel">1</SetVariable>
              </Template>
              <Template src="skin:templates/keyfx_deck_row.xml">
                <SetVariable name="channel">2</SetVariable>
              </Template>

              <WidgetGroup>
                <ObjectName>BeatFX_Spacer</ObjectName>
                <Size>0me,0me</Size>
              </WidgetGroup>

            </Children>
          </WidgetGroup>

        </Children>
      </WidgetStack>

    </Children>
  </WidgetGroup>
</Template>