<!-- Beat period in beats. Native parameterN_beat_period converts rate-based
     parameters and mirrors the actual clamped value for truthful highlighting. -->
<Template>
  <PushButton>
    <ObjectName>BeatFX_BucketButton</ObjectName>
    <Size>0me,32f</Size>
    <NumberStates>2</NumberStates>
    <State>
      <Number>0</Number>
      <Text><Variable name="Label"/></Text>
    </State>
    <State>
      <Number>1</Number>
      <Text><Variable name="Label"/></Text>
    </State>
    <Connection>
      <ConfigKey><Variable name="EffectGroup"/>,parameter<Variable name="param"/>_beat_period</ConfigKey>
      <EmitOnDownPress>true</EmitOnDownPress>
      <Transform>
        <IsEqual><Variable name="Value"/></IsEqual>
      </Transform>
    </Connection>
  </PushButton>
</Template>
