<Template>
  <SetVariable name="EffectGroup">[EffectRack<Variable name="rack" />_EffectUnit<Variable name="unit" />_Effect<Variable name="effect" />]</SetVariable>
  <WidgetGroup>
    <ObjectName>BeatFX_ParamRow</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,min</SizePolicy>
    <Children>
      <WidgetGroup>
        <ObjectName>BeatFX_PeriodRow</ObjectName>
        <Layout>vertical</Layout>
        <SizePolicy>me,min</SizePolicy>
        <Children>
          <Label>
            <ObjectName>BeatFX_BeatsLabel</ObjectName>
            <Text>BEATS</Text>
            <Size>0me,20f</Size>
            <Alignment>center</Alignment>
          </Label>
          <BeatPeriodPicker>
            <EffectGroup>
              <Variable name="EffectGroup" />
            </EffectGroup>
            <Parameter>
              <Variable name="param" />
            </Parameter>
            <Size>0me,60f</Size>
          </BeatPeriodPicker>
        </Children>
        <Connection>
          <ConfigKey>
            <Variable name="EffectGroup" />,parameter<Variable name="param" />_units</ConfigKey>
          <BindProperty>visible</BindProperty>
          <Transform>
            <IsEqual>1</IsEqual>
          </Transform>
        </Connection>
      </WidgetGroup>
    </Children>
    <Connection>
      <ConfigKey>
        <Variable name="EffectGroup" />,parameter<Variable name="param" />_loaded</ConfigKey>
      <BindProperty>visible</BindProperty>
    </Connection>
  </WidgetGroup>
</Template>
