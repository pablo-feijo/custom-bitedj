<!DOCTYPE template>
<!--
  Description:
    The cue drawer for one deck: a header (which deck, which bank, close) over
    a 4x2 pad grid. Instantiated once per deck by cuepanel.xml.

    Cue banks and performance pads share a per-deck mode; the header cycles
    them by touch even when no controller is connected.
    The banks share a bounded stacked layout so separate visibility updates
    cannot add their heights or shift the header. Keep the bank area at 92px:
    two 44px rows plus their 4px gap, below the 44px navigation header.

    The pad grid is sized so that all eight pads clear the 44px touch floor at
    the 480x420 design minimum: 4 columns of ~117px, 2 rows of 44px.
  Variables:
    channel: deck number.
-->
<Template>
  <WidgetGroup>
    <ObjectName>CuePanel_Page</ObjectName>
    <Layout>vertical</Layout>
    <SizePolicy>me,me</SizePolicy>
    <Children>

      <WidgetGroup>
        <ObjectName>CuePanel_Header</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,44f</Size>
        <Children>
          <Label>
            <ObjectName>CuePanel_DeckLabel</ObjectName>
            <Text>Deck <Variable name="channel"/></Text>
            <Size>80f,44f</Size>
          </Label>

          <PushButton>
            <ObjectName>CuePanel_Previous</ObjectName>
            <Size>48f,44f</Size>
            <NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>‹</Text></State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[PadFX],d<Variable name="channel"/>_previous</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>CuePanel_BankToggle</ObjectName>
            <Size>0me,44f</Size>
            <NumberStates>6</NumberStates>
            <State><Number>0</Number><Text>Hot Cues</Text></State>
            <State><Number>1</Number><Text>Pad FX 1</Text></State>
            <State><Number>2</Number><Text>Beat Jump</Text></State>
            <State><Number>3</Number><Text>Beat Loop</Text></State>
            <State><Number>4</Number><Text>Memory</Text></State>
            <State><Number>5</Number><Text>Pad FX 2</Text></State>
            <Connection>
              <ConfigKey>[PadFX],d<Variable name="channel"/>_mode</ConfigKey>
              <ConnectValueFromWidget>false</ConnectValueFromWidget>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>CuePanel_Next</ObjectName>
            <Size>48f,44f</Size>
            <NumberStates>1</NumberStates>
            <State><Number>0</Number><Text>›</Text></State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[PadFX],d<Variable name="channel"/>_cycle</ConfigKey>
              <ConnectValueToWidget>false</ConnectValueToWidget>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
            </Connection>
          </PushButton>

          <PushButton>
            <ObjectName>CuePanel_Close</ObjectName>
            <Size>44f,44f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>&#10005;</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>&#10005;</Text>
            </State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[Skin],cue_close</ConfigKey>
              <EmitOnDownPress>true</EmitOnDownPress>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>

      <WidgetGroup>
        <ObjectName>CuePanel_Banks</ObjectName>
        <Layout>stacked</Layout>
        <Size>0me,92f</Size>
        <Children>
          <!-- Hot cue bank: slots 1-8, the same pads a controller maps. -->
          <WidgetGroup>
            <ObjectName>CuePanel_Grid</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <WidgetGroup>
                <ObjectName>CuePanel_Row</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,44f</Size>
                <Children>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">1</SetVariable>
                    <SetVariable name="label">A</SetVariable>
                  </Template>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">2</SetVariable>
                    <SetVariable name="label">B</SetVariable>
                  </Template>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">3</SetVariable>
                    <SetVariable name="label">C</SetVariable>
                  </Template>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">4</SetVariable>
                    <SetVariable name="label">D</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>CuePanel_Row</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,44f</Size>
                <Children>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">5</SetVariable>
                    <SetVariable name="label">E</SetVariable>
                  </Template>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">6</SetVariable>
                    <SetVariable name="label">F</SetVariable>
                  </Template>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">7</SetVariable>
                    <SetVariable name="label">G</SetVariable>
                  </Template>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">8</SetVariable>
                    <SetVariable name="label">H</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
            </Children>
            <Connection>
              <ConfigKey>[PadFX],d<Variable name="channel"/>_mode</ConfigKey>
              <BindProperty>visible</BindProperty>
              <Transform><IsEqual>0</IsEqual></Transform>
            </Connection>
          </WidgetGroup>

          <!-- Memory cue bank: slots 17-24, chronological. Keep in step with
               kMemoryCueBankStart / kMemoryCueBankSize in cueinfo.h. -->
          <WidgetGroup>
            <ObjectName>CuePanel_Grid</ObjectName>
            <Layout>vertical</Layout>
            <SizePolicy>me,me</SizePolicy>
            <Children>
              <WidgetGroup>
                <ObjectName>CuePanel_Row</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,44f</Size>
                <Children>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">17</SetVariable>
                    <SetVariable name="label">M1</SetVariable>
                  </Template>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">18</SetVariable>
                    <SetVariable name="label">M2</SetVariable>
                  </Template>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">19</SetVariable>
                    <SetVariable name="label">M3</SetVariable>
                  </Template>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">20</SetVariable>
                    <SetVariable name="label">M4</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>CuePanel_Row</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,44f</Size>
                <Children>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">21</SetVariable>
                    <SetVariable name="label">M5</SetVariable>
                  </Template>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">22</SetVariable>
                    <SetVariable name="label">M6</SetVariable>
                  </Template>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">23</SetVariable>
                    <SetVariable name="label">M7</SetVariable>
                  </Template>
                  <Template src="skin:templates/cue_pad.xml">
                    <SetVariable name="channel"><Variable name="channel"/></SetVariable>
                    <SetVariable name="hotcue">24</SetVariable>
                    <SetVariable name="label">M8</SetVariable>
                  </Template>
                </Children>
              </WidgetGroup>
            </Children>
            <Connection>
              <ConfigKey>[PadFX],d<Variable name="channel"/>_mode</ConfigKey>
              <BindProperty>visible</BindProperty>
              <Transform><IsEqual>4</IsEqual></Transform>
            </Connection>
          </WidgetGroup>

          <ControllerPadDisplay>
            <Channel><Variable name="channel"/></Channel><SizePolicy>me,me</SizePolicy>
            <Connection><ConfigKey>[PadFX],d<Variable name="channel"/>_performance_visible</ConfigKey><BindProperty>visible</BindProperty></Connection>
          </ControllerPadDisplay>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>
