<Template>
  <WidgetStack currentpage="[BiteDJ],training_mode">
    <ObjectName>Waveforms</ObjectName>
    <!-- Fill the width left of the fixed 204px control panel. This resolves to
         820px on the original 1024x600 display and 1076px on the 1280x720
         Raspberry Pi Touch Display 2. -->
    <Size>0me,0me</Size>
    <Children>
      <WidgetGroup>
        <ObjectName>WaveformsNormal</ObjectName>
        <Layout>vertical</Layout>
        <Size>0me,0me</Size>
        <Children>
          <Template src="skin:waveform.xml"><SetVariable name="channel">1</SetVariable></Template>
          <Template src="skin:waveform.xml"><SetVariable name="channel">2</SetVariable></Template>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>TrainingLineLayout</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,0me</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>TrainingDeckControls</ObjectName>
            <Layout>vertical</Layout>
            <Size>126f,0me</Size>
            <Children>
              <Template src="skin:waveform.xml"><SetVariable name="channel">1</SetVariable></Template>
              <Template src="skin:waveform.xml"><SetVariable name="channel">2</SetVariable></Template>
            </Children>
          </WidgetGroup>
          <TrainingPhase>
            <ObjectName>TrainingPhaseLine</ObjectName>
            <Size>0me,0me</Size>
            <Deck1Color>#ff4a45</Deck1Color>
            <Deck2Color>#12b9ff</Deck2Color>
            <LineDeck1Color>#d79a3b</LineDeck1Color>
            <LineDeck2Color>#12b9ff</LineDeck2Color>
            <ActiveColor>#ff9f2d</ActiveColor>
            <LineActiveColor>#ff4a45</LineActiveColor>
            <MarkerColor>#ffffff</MarkerColor>
          </TrainingPhase>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>TrainingBoxesLayout</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,0me</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>TrainingDeckControls</ObjectName>
            <Layout>vertical</Layout>
            <Size>126f,0me</Size>
            <Children>
              <Template src="skin:waveform.xml"><SetVariable name="channel">1</SetVariable></Template>
              <Template src="skin:waveform.xml"><SetVariable name="channel">2</SetVariable></Template>
            </Children>
          </WidgetGroup>
          <TrainingPhase>
            <ObjectName>TrainingPhaseBoxes</ObjectName>
            <Size>0me,0me</Size>
            <Deck1Color>#ff4a45</Deck1Color>
            <Deck2Color>#12b9ff</Deck2Color>
            <ActiveColor>#ff9f2d</ActiveColor>
            <MarkerColor>#ffffff</MarkerColor>
          </TrainingPhase>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetStack>
</Template>
