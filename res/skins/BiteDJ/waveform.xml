<Template>
  <WidgetGroup>
    <ObjectName>Waveform_Channel<Variable name="channel"/></ObjectName>
    <Layout>horizontal</Layout>
    <Size>0me,50me</Size>
    <Children>
      <!-- 110px content + 6px inset + 10px separation. Beat jump lives in the right panel. -->
      <WidgetGroup>
        <ObjectName>WaveformInfo</ObjectName>
        <Layout>vertical</Layout>
        <Size>126f,0me</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>WaveformSourceRow</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,26f</Size>
            <Children>
              <TrackProperty>
                <ObjectName>WaveformSource</ObjectName>
                <Size>110f,26f</Size>
                <Property>source</Property>
                <Connection>
                  <ConfigKey>[Recording],deck<Variable name="channel"/>_source</ConfigKey>
                  <BindProperty>recording</BindProperty>
                </Connection>
                <DisableActions>true</DisableActions>
                <Elide>right</Elide>
                <Channel><Variable name="channel"/></Channel>
              </TrackProperty>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>WaveformKeyLoopRow</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,28f</Size>
            <Children>
              <WidgetGroup>
                <ObjectName>WaveformMetadataCell</ObjectName>
                <Layout>vertical</Layout>
                <Size>53f,28f</Size>
                <Children>
                  <Label><ObjectName>WaveformCaption</ObjectName><Size>0me,11f</Size><Text>KEY</Text></Label>
                  <Key>
                    <ObjectName>WaveformKeyValue</ObjectName>
                    <Size>0me,17f</Size>
                    <Channel><Variable name="channel"/></Channel>
                    <Connection><ConfigKey>[Channel<Variable name="channel"/>],visual_key</ConfigKey></Connection>
                    <Connection><ConfigKey>[Channel<Variable name="channel"/>],key_shifted</ConfigKey><BindProperty>highlight</BindProperty></Connection>
                  </Key>
                </Children>
              </WidgetGroup>
              <WidgetGroup>
                <ObjectName>WaveformMetadataCell</ObjectName>
                <Layout>vertical</Layout>
                <Size>53f,28f</Size>
                <Children>
                  <Label>
                    <ObjectName>WaveformCaption</ObjectName><Size>0me,11f</Size><Text>LOOP</Text>
                    <Connection><ConfigKey>[Channel<Variable name="channel"/>],loop_enabled</ConfigKey><BindProperty>highlight</BindProperty></Connection>
                  </Label>
                  <BeatSpinBox>
                    <ObjectName>WaveformLoopValue</ObjectName>
                    <Size>0me,17f</Size>
                    <Value>[Channel<Variable name="channel"/>],beatloop_size</Value>
                    <ReadOnly>true</ReadOnly>
                  </BeatSpinBox>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>WaveformStateRow</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,44f</Size>
            <Children>
              <PushButton>
                <ObjectName>WaveformStateButton</ObjectName>
                <Size>53f,44f</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                  <Text>QNT</Text>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>QNT</Text>
                </State>
                <Connection>
                  <ConfigKey>[Channel<Variable name="channel"/>],quantize</ConfigKey>
                  <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                </Connection>
              </PushButton>
              <PushButton>
                <ObjectName>WaveformStateButton</ObjectName>
                <Size>53f,44f</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                  <Text>LOCK</Text>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>LOCK</Text>
                </State>
                <Connection>
                  <ConfigKey>[Channel<Variable name="channel"/>],keylock</ConfigKey>
                  <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>WaveformTransportRow</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,44f</Size>
            <Children>
              <PushButton>
                <ObjectName>WaveformTransportButton</ObjectName>
                <Size>53f,44f</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                  <Text>▶</Text>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>▶</Text>
                </State>
                <Connection>
                  <ConfigKey>[Channel<Variable name="channel"/>],play</ConfigKey>
                  <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                </Connection>
              </PushButton>
              <PushButton>
                <ObjectName>WaveformTransportButton</ObjectName>
                <Size>53f,44f</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                  <Text>CUE</Text>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>CUE</Text>
                </State>
                <Connection>
                  <ConfigKey>[Channel<Variable name="channel"/>],cue_default</ConfigKey>
                  <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
                </Connection>
              </PushButton>
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
      <Visual>
            <BiteDJPalette>true</BiteDJPalette>
        <TooltipId>waveform_display</TooltipId>
        <ObjectName>Waveform<Variable name="channel"/></ObjectName>
        <Channel><Variable name="channel"/></Channel>
        <DisableSeek>true</DisableSeek>
        <Connection>
          <ConfigKey>[BiteDJ],training_mode</ConfigKey>
          <BindProperty>visible</BindProperty>
          <Transform><Not/></Transform>
        </Connection>
        <Connection><ConfigKey>[FxPanel],grid</ConfigKey><BindProperty>gridEditMode</BindProperty></Connection>
        <BgColor>#000</BgColor>
        <BeatColor>#fff</BeatColor>
        <BeatDownbeatColor>#f15921</BeatDownbeatColor>
        <PlayPosColor>#fff</PlayPosColor>
        <SignalColor>#32323c</SignalColor>
        <SignalLowColor>#004ee4</SignalLowColor>
        <SignalMidColor>#c95a00</SignalMidColor>
        <SignalHighColor>#f6e9d3</SignalHighColor>
        <DefaultMark>
          <Align>bottom|right</Align>
          <Color>#FF0000</Color>
          <TextColor>#FFFFFF</TextColor>
         <Text> %1 </Text>
        </DefaultMark>
        <Mark>
          <Control>cue_point</Control>
          <Text>CUE</Text>
          <Color>#ff6000</Color>
          <TextColor>#ff6000</TextColor>
          <Align>bottom</Align>
        </Mark>
        <!-- Hot cue bank (slots 1-8 = rekordbox pads A-H). <Hotcue> binds the
             end position and type as well as the position, so saved loops draw
             their range and each mark takes the cue's own colour and label.
             These also override the DefaultMark above for their slots. -->
        <Mark>
          <Hotcue>1</Hotcue>
          <Text>A</Text>
          <Color>#f44040</Color>
          <TextColor>#f44040</TextColor>
          <Align>top</Align>
        </Mark>
        <Mark>
          <Hotcue>2</Hotcue>
          <Text>B</Text>
          <Color>#0ddcf2</Color>
          <TextColor>#0ddcf2</TextColor>
          <Align>top</Align>
        </Mark>
        <Mark>
          <Hotcue>3</Hotcue>
          <Text>C</Text>
          <Color>#a5df13</Color>
          <TextColor>#a5df13</TextColor>
          <Align>top</Align>
        </Mark>
        <Mark>
          <Hotcue>4</Hotcue>
          <Text>D</Text>
          <Color>#9d4cfd</Color>
          <TextColor>#9d4cfd</TextColor>
          <Align>top</Align>
        </Mark>
        <Mark>
          <Hotcue>5</Hotcue>
          <Text>E</Text>
          <Color>#3fec2b</Color>
          <TextColor>#3fec2b</TextColor>
          <Align>top</Align>
        </Mark>
        <Mark>
          <Hotcue>6</Hotcue>
          <Text>F</Text>
          <Color>#e6681c</Color>
          <TextColor>#e6681c</TextColor>
          <Align>top</Align>
        </Mark>
        <Mark>
          <Hotcue>7</Hotcue>
          <Text>G</Text>
          <Color>#2749c8</Color>
          <TextColor>#2749c8</TextColor>
          <Align>top</Align>
        </Mark>
        <Mark>
          <Hotcue>8</Hotcue>
          <Text>H</Text>
          <Color>#c7b205</Color>
          <TextColor>#c7b205</TextColor>
          <Align>top</Align>
        </Mark>

        <!-- Memory cue bank (slots 17-24, chronological). Bottom-aligned to
             separate them at a glance from the hot cues on top. Keep in step
             with kMemoryCueBankStart / kMemoryCueBankSize in cueinfo.h. -->
        <Mark>
          <Hotcue>17</Hotcue>
          <Text>M1</Text>
          <Color>#9aa0a6</Color>
          <TextColor>#9aa0a6</TextColor>
          <Align>bottom</Align>
        </Mark>
        <Mark>
          <Hotcue>18</Hotcue>
          <Text>M2</Text>
          <Color>#9aa0a6</Color>
          <TextColor>#9aa0a6</TextColor>
          <Align>bottom</Align>
        </Mark>
        <Mark>
          <Hotcue>19</Hotcue>
          <Text>M3</Text>
          <Color>#9aa0a6</Color>
          <TextColor>#9aa0a6</TextColor>
          <Align>bottom</Align>
        </Mark>
        <Mark>
          <Hotcue>20</Hotcue>
          <Text>M4</Text>
          <Color>#9aa0a6</Color>
          <TextColor>#9aa0a6</TextColor>
          <Align>bottom</Align>
        </Mark>
        <Mark>
          <Hotcue>21</Hotcue>
          <Text>M5</Text>
          <Color>#9aa0a6</Color>
          <TextColor>#9aa0a6</TextColor>
          <Align>bottom</Align>
        </Mark>
        <Mark>
          <Hotcue>22</Hotcue>
          <Text>M6</Text>
          <Color>#9aa0a6</Color>
          <TextColor>#9aa0a6</TextColor>
          <Align>bottom</Align>
        </Mark>
        <Mark>
          <Hotcue>23</Hotcue>
          <Text>M7</Text>
          <Color>#9aa0a6</Color>
          <TextColor>#9aa0a6</TextColor>
          <Align>bottom</Align>
        </Mark>
        <Mark>
          <Hotcue>24</Hotcue>
          <Text>M8</Text>
          <Color>#9aa0a6</Color>
          <TextColor>#9aa0a6</TextColor>
          <Align>bottom</Align>
        </Mark>

        <Mark>
          <Control>loop_start_position</Control>
          <Text>IN</Text>
          <Color>#f15921</Color>
          <Align>top</Align>
        </Mark>
        <Mark>
          <Control>loop_end_position</Control>
          <Text>OUT</Text>
          <Color>#f15921</Color>
          <Align>top</Align>
        </Mark>
        <MarkRange>
          <StartControl>loop_start_position</StartControl>
          <EndControl>loop_end_position</EndControl>
          <EnabledControl>loop_enabled</EnabledControl>
          <Color>#f15921</Color>
          <Opacity>1</Opacity>
          <DisabledColor>#acacac</DisabledColor>
          <DisabledOpacity>0.4</DisabledOpacity>
        </MarkRange>
      </Visual>
    </Children>
  </WidgetGroup>
</Template>
